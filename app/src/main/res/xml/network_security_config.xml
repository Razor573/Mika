<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 http:用户自己在本机或局域网跑的模型服务(如 http://192.168.1.10:11434/v1)多半只有 http。
  内置浏览器因此也能直接打开 http 网页(不再先被系统拒绝、再换 https 重试)。
  添加服务商时,不加密又不在本机、局域网的地址会提示一句(见 LocalHosts)。
  HTTPS 仅信任系统预置根证书,不信任用户安装的 CA。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
